    },
    {
      "parameters": {
        "jsCode": "// El reloj manda un WAV crudo: se le pone nombre y tipo para que Groq lo reconozca.\nconst item = $input.first();\nitem.binary.audio.fileName = 'pregunta.wav';\nitem.binary.audio.mimeType = 'audio/wav';\nitem.binary.audio.fileExtension = 'wav';\nreturn [item];"
      },
