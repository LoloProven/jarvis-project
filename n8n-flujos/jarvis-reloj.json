    {
      "parameters": {
        "jsCode": "// Texto para la pantalla del reloj: solo ASCII (la letra del reloj no tiene tildes ni ñ)\n// y corto, porque va en los encabezados X-Pregunta / X-Respuesta.\nconst ascii = (s) => String(s || '')\n  .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n  .replace(/[^\\x20-\\x7E]/g, '').replace(/\\s+/g, ' ').trim();\nconst pregunta = ascii($('Voz a texto').first().json.text).slice(0, 150);\nconst respuesta = ascii($('JARVIS').first().json.output || 'No pude responder.').slice(0, 390);\n\n// Órdenes para el reloj: cada herramienta del reloj devuelve \"ACCION:ALARMA 07:00 - ...\".\n// Se juntan en el encabezado X-Accion (\"ALARMA 07:00;TIMER 600\") y el reloj las ejecuta.\nconst pasos = JSON.stringify($('JARVIS').first().json.intermediateSteps || []);\nconst accion = [...pasos.matchAll(/ACCION:([A-Z]+ [A-Z0-9:]+)/g)].map((m) => m[1]).join(';');\n\n// Voz: n8n-flujos/voz.mjs (Piper, voz Sharvard; si falla, la de Windows) la deja en base64,\n// PCM mono de 16 bits a 24 kHz (lo que espera el reloj). Si no hubo voz, un silencio cortito.\nlet b64 = '';\ntry { b64 = $('Voz').first().json.stdout.trim(); } catch (e) {}\nif (!b64) b64 = Buffer.alloc(2).toString('base64');\n\nreturn [{\n  json: { pregunta, respuesta, accion },\n  binary: { voz: { data: b64, mimeType: 'application/octet-stream', fileName: 'respuesta.pcm' } },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "id": "7d1f0c52-3a8e-4f0e-9a51-0b6c2a1e9d09",
