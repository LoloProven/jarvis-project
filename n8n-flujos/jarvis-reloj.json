                "value": "={{ $json.pregunta }}"
              },
              {
                "name": "X-Respuesta",
                "value": "={{ $json.respuesta }}"
              }
            ]
          }
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
