    {
      "parameters": {
        "description": "Pone una alarma diaria en el reloj del usuario a esa hora (formato 24 h).",
        "language": "javaScript",
        "jsCode": "const p = (n) => String(n).padStart(2, '0');\nreturn `ACCION:ALARMA ${p(query.hora)}:${p(query.minuto)} - listo, alarma puesta en el reloj`;",
        "specifyInputSchema": true,
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"hora\": {\n      \"type\": \"integer\",\n      \"description\": \"Hora 0-23\"\n    },\n    \"minuto\": {\n      \"type\": \"integer\",\n      \"description\": \"Minuto 0-59\"\n    }\n  },\n  \"required\": [\n    \"hora\",\n    \"minuto\"\n  ]\n}"
      },
