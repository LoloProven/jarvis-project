    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-tts:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: 'Decilo en espanol rioplatense, con tono amigable: ' + $json.output }] }], generationConfig: { responseModalities: ['AUDIO'], speechConfig: { voiceConfig: { prebuiltVoiceConfig: { voiceName: 'Charon' } } } } }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "id": "7d1f0c52-3a8e-4f0e-9a51-0b6c2a1e9d08",
      "name": "Texto a voz",
      "onError": "continueRegularOutput",
      "credentials": {
        "googlePalmApi": {
          "id": "Bw1FsFIhxaobnbSh",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Texto para la pantalla del reloj: solo ASCII (la letra del reloj no tiene tildes ni ñ)\n// y corto, porque va en los encabezados X-Pregunta / X-Respuesta.\nconst ascii = (s) => String(s || '')\n  .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n  .replace(/[^\\x20-\\x7E]/g, '').replace(/\\s+/g, ' ').trim();\nconst pregunta = ascii($('Voz a texto').first().json.text).slice(0, 150);\nconst respuesta = ascii($('JARVIS').first().json.output || 'No pude responder.').slice(0, 390);\n\n// Voz: Gemini la devuelve en base64, PCM mono de 16 bits a 24 kHz (lo que espera el reloj).\n// Si falló, se manda un silencio cortito y el reloj solo muestra el texto.\nlet b64 = '';\ntry { b64 = $input.first().json.candidates[0].content.parts[0].inlineData.data; } catch (e) {}\nif (!b64) b64 = Buffer.alloc(2).toString('base64');\n\nreturn [{\n  json: { pregunta, respuesta },\n  binary: { voz: { data: b64, mimeType: 'application/octet-stream', fileName: 'respuesta.pcm' } },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "id": "7d1f0c52-3a8e-4f0e-9a51-0b6c2a1e9d09",
      "name": "Armar respuesta"
    },
    {
      "parameters": {
        "respondWith": "binary",
        "responseDataSource": "set",
        "inputFieldName": "voz",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "X-Pregunta",
                "value": "={{ $json.pregunta }}"
              },
              {
                "name": "X-Respuesta",
                "value": "={{ $json.respuesta }}"
              }
            ]
          }
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1320,
        0
      ],
      "id": "7d1f0c52-3a8e-4f0e-9a51-0b6c2a1e9d10",
      "name": "Responder al reloj"
    }
