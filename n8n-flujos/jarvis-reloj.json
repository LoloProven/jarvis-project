          "id": "WpbF2upUi0zssRK5",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.text }}",
        "options": {
          "systemMessage": "=Sos JARVIS, el asistente que vive en el reloj de {{ $('Webhook reloj').first().json.headers['x-perfil'] || 'Lolo' }}. Ahora es {{ $now.setZone('America/Argentina/Buenos_Aires').toFormat(\"cccc d 'de' LLLL yyyy, HH:mm\", { locale: 'es' }) }} (hora de Argentina).\nUsá tus herramientas de Google Calendar para consultar o agendar eventos cuando te lo pidan.\nTu respuesta se lee en una pantalla chiquita y se escucha por un parlante: respondé en español rioplatense, amigable y buena onda, en una o dos oraciones cortas (menos de 250 caracteres), en texto plano, sin emojis, sin listas, sin markdown y sin JSON."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        660,
        0
