    {
      "parameters": {
        "jsCode": "// Texto para la pantalla del reloj: solo ASCII (la letra del reloj no tiene tildes ni ñ)\n// y corto, porque va en los encabezados X-Pregunta / X-Respuesta.\nconst ascii = (s) => String(s || '')\n  .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n  .replace(/[^\\x20-\\x7E]/g, '').replace(/\\s+/g, ' ').trim();\nconst pregunta = ascii($('Voz a texto').first().json.text).slice(0, 150);\nconst respuesta = ascii($('JARVIS').first().json.output || 'No pude responder.').slice(0, 390);\n\n// Voz: Gemini la devuelve en base64, PCM mono de 16 bits a 24 kHz (lo que espera el reloj).\n// Si falló, se manda un silencio cortito y el reloj solo muestra el texto.\n// Si Gemini no pudo (se acabó el uso gratis del día), se usa la voz de Windows de la compu.\nlet b64 = '';\ntry { b64 = $('Texto a voz').first().json.candidates[0].content.parts[0].inlineData.data; } catch (e) {}\nif (!b64) { try { b64 = $('Voz Windows').first().json.stdout.trim(); } catch (e) {} }\nif (!b64) b64 = Buffer.alloc(2).toString('base64');\n\nreturn [{\n  json: { pregunta, respuesta },\n  binary: { voz: { data: b64, mimeType: 'application/octet-stream', fileName: 'respuesta.pcm' } },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
