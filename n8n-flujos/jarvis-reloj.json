        "language": "javaScript",
        "jsCode": "const s = Math.round(Number(query.minutos) * 60);\nif (!(s > 0)) return 'No entendi la duracion';\nreturn `ACCION:TIMER ${s} - listo, temporizador de ${query.minutos} min andando en el reloj`;",
        "specifyInputSchema": true,
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"minutos\": {\n      \"type\": \"number\",\n      \"description\": \"Duracion en minutos (puede tener decimales, 0.5 = 30 segundos)\"\n    }\n  },\n  \"required\": [\n    \"minutos\"\n  ]\n}"
      },
