    {
      "parameters": {
        "description": "Maneja el cronometro del reloj (cuenta hacia arriba; tambien cuenta los pasos y km de la sesion).",
        "language": "javaScript",
        "jsCode": "const ok = { iniciar: 'INICIAR', pausar: 'PAUSAR', reset: 'RESET' };\nconst a = ok[String(query.accion).toLowerCase()];\nif (!a) return 'Accion invalida: usa iniciar, pausar o reset';\nreturn `ACCION:CRONO ${a} - listo, cronometro (${query.accion}) en el reloj`;",
        "specifyInputSchema": true,
        "schemaType": "manual",
