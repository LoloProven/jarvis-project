    {
      "parameters": {
        "jsCode": "// Qué pestaña y qué buscar (?pestana=Registro|Comidas|Agua&buscar=press banca).\nconst q = $json.query || {};\nconst PESTANAS = { registro: ['Registro', 353537118], comidas: ['Comidas', 2124048794], agua: ['Agua', 534786565] };\nconst norm = s => String(s || '').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').trim();\nconst p = PESTANAS[norm(q.pestana).replace('comida', 'comidas').replace('comidass', 'comidas')] || PESTANAS.registro;\nreturn [{ json: { pestana: p[0], sheetId: p[1], buscar: norm(q.buscar) } }];"
      },
      "id": "c1b2c3d4-0002-4000-8000-000000000002",
      "name": "Preparar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/1z7vetEM6Z9Mu1vkKSDYRMLkqp6c15mvZvDmIxSThzKs/values/{{ $json.pestana }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "options": {}
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000003",
      "name": "Leer pestaña",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "jarvisSheets0001",
          "name": "Google Sheets JARVIS"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// La última fila (la más nueva) cuyo texto contiene lo buscado; sin texto, la última de todas.\nconst pr = $('Preparar').first().json;\nconst filas = $json.values || [];\nconst norm = s => String(s || '').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').trim();\nconst palabras = pr.buscar.split(/\\s+/).filter(w => w.length > 2);\nlet fila = -1;\nfor (let i = filas.length - 1; i >= 1; i--) {\n  const t = norm(filas[i].join(' '));\n  if (!t) continue;\n  if (!palabras.length || palabras.every(w => t.includes(w))) { fila = i; break; }\n}\nreturn [{ json: { ...pr, fila, encontrado: fila >= 1, texto: fila >= 1 ? filas[fila].filter(Boolean).join(' | ') : '' } }];"
      },
      "id": "c1b2c3d4-0004-4000-8000-000000000004",
      "name": "Buscar fila",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.encontrado }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c1b2c3d4-0005-4000-8000-000000000005",
      "name": "¿Encontró?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        800,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/1z7vetEM6Z9Mu1vkKSDYRMLkqp6c15mvZvDmIxSThzKs:batchUpdate",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ requests: [{ deleteDimension: { range: { sheetId: $json.sheetId, dimension: \"ROWS\", startIndex: $json.fila, endIndex: $json.fila + 1 } } }] }) }}",
        "options": {}
      },
      "id": "c1b2c3d4-0006-4000-8000-000000000006",
      "name": "Borrar fila",
